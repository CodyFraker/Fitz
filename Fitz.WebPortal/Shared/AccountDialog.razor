@using Fitz.WebPortal.Data
@using Microsoft.EntityFrameworkCore
@using Fitz.Features.Accounts.Models
@inject BotContext BotContext
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Create Account</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudTextField @bind-Value="_account.Username" Label="Username" Required="true" />
            <MudNumericField T="int" @bind-Value="_account.Beer" Label="Initial Beer" Required="true" Min="0" />
            <MudCheckBox @bind-Checked="_account.Deactivated" Label="Inactive" />
            <MudCheckBox @bind-Checked="_account.subscribeToLottery" Label="Subscribe to Lottery" />
            <MudNumericField T="int" @bind-Value="_account.SubscribeTickets" Label="Subscription Tickets" 
                           Disabled="@(!_account.subscribeToLottery)" Min="1" Max="10" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@(!_isValid)">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;

    private MudForm _form = null!;
    private bool _isValid;
    private Fitz.WebPortal.Data.Account _account = new()
    {
        Beer = 0,
        Deactivated = false,
        subscribeToLottery = false,
        SubscribeTickets = 1
    };

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Submit()
    {
        try
        {
            await _form.Validate();
            if (!_isValid)
            {
                return;
            }

            // Check if username already exists
            var existingAccount = await BotContext.Accounts
                .FirstOrDefaultAsync(a => a.Username == _account.Username);

            if (existingAccount != null)
            {
                Snackbar.Add("An account with this username already exists.", Severity.Error);
                return;
            }

            BotContext.Accounts.Add(_account);
            await BotContext.SaveChangesAsync();

            MudDialog.Close(DialogResult.Ok(_account));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error creating account: {ex.Message}", Severity.Error);
        }
    }
} 