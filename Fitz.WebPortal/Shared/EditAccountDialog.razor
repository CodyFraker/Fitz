@using Fitz.WebPortal.Data
@using Microsoft.EntityFrameworkCore
@using Fitz.Features.Accounts.Models
@inject WebPortalContext Context
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit Account</MudText>
    </TitleContent>
    <DialogContent>
        @if (Account == null)
        {
            <MudAlert Severity="Severity.Error">No account data available</MudAlert>
        }
        else
        {
            <MudForm @ref="_form" @bind-IsValid="@_isValid">
                <MudGrid>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_account.Username" Label="Username" Required="true" 
                                     RequiredError="Username is required" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField T="int" @bind-Value="_account.Beer" Label="Beer" Required="true" Min="0" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSwitch @bind-Checked="@_isActive" Label="Active" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSwitch @bind-Checked="_account.subscribeToLottery" Label="Subscribe to Lottery" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField T="int" @bind-Value="_account.SubscribeTickets" Label="Subscription Tickets" 
                                       Disabled="@(!_account.subscribeToLottery)" Min="1" Max="10" />
                    </MudItem>
                </MudGrid>
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@(!_isValid)">Save Changes</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Fitz.WebPortal.Data.Account Account { get; set; } = null!;
    
    private MudForm _form = null!;
    private bool _isValid;
    private bool _isActive;
    private Fitz.WebPortal.Data.Account _account = new();
    
    protected override void OnInitialized()
    {
        if (Account != null)
        {
            _account = Account;
            _isActive = !_account.Deactivated;
        }
    }
    
    private void Cancel()
    {
        MudDialog.Cancel();
    }
    
    private async Task Submit()
    {
        if (!_isValid || Account == null)
            return;
            
        try
        {
            await _form.Validate();
            if (!_isValid)
            {
                return;
            }

            // Check if username already exists (excluding current account)
            var existingAccount = await Context.Accounts
                .FirstOrDefaultAsync(a => a.Username == _account.Username && a.Id != _account.Id);

            if (existingAccount != null)
            {
                Snackbar.Add("An account with this username already exists.", Severity.Error);
                return;
            }

            _account.Deactivated = !_isActive;
            Context.Accounts.Update(_account);
            await Context.SaveChangesAsync();
            
            MudDialog.Close(DialogResult.Ok(_account));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating account: {ex.Message}", Severity.Error);
        }
    }
} 