@using Fitz.WebPortal.Data
@using Microsoft.EntityFrameworkCore
@using Fitz.Features.Accounts.Models
@using Fitz.Features.Lottery.Models
@inject WebPortalContext Context
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Buy Lottery Tickets</MudText>
    </TitleContent>
    <DialogContent>
        @if (_lottery == null)
        {
            <MudAlert Severity="Severity.Error">No lottery data available</MudAlert>
        }
        else
        {
            <MudGrid>
                <MudItem xs="12">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6">Lottery #@_lottery.Id</MudText>
                        <MudText>Prize Pool: @_lottery.Pool beer</MudText>
                        <MudText>End Date: @_lottery.EndDate.ToString("g")</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" Class="mt-4">
                    <MudNumericField T="int" @bind-Value="_ticketCount" Label="Number of Tickets" Required="true" Min="1" Max="100" />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@(_lottery == null || _ticketCount < 1)">Buy Tickets</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int LotteryId { get; set; }
    [Parameter] public Fitz.WebPortal.Data.Account Account { get; set; } = null!;

    private Fitz.WebPortal.Data.Lottery _lottery;
    private int _ticketCount = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadLotteryData();
    }

    private async Task LoadLotteryData()
    {
        try
        {
            _lottery = await Context.Lotteries
                .Include(l => l.Tickets)
                .FirstOrDefaultAsync(l => l.Id == LotteryId);

            if (_lottery == null)
            {
                Snackbar.Add("Failed to load lottery data.", Severity.Error);
                return;
            }

            if (!_lottery.CurrentLottery)
            {
                Snackbar.Add("This lottery is no longer active.", Severity.Warning);
                return;
            }

            if (Account.Deactivated)
            {
                Snackbar.Add("Your account is not active.", Severity.Warning);
                return;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading lottery data: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Submit()
    {
        try
        {
            if (_lottery == null || _ticketCount < 1)
            {
                return;
            }

            var totalCost = _ticketCount;
            if (Account.Beer < totalCost)
            {
                Snackbar.Add($"Insufficient balance. You need {totalCost} beer to buy {_ticketCount} tickets.", Severity.Warning);
                return;
            }

            // Create tickets
            for (var i = 0; i < _ticketCount; i++)
            {
                var ticket = new Fitz.WebPortal.Data.Ticket
                {
                    LotteryId = _lottery.Id,
                    UserId = Account.Id,
                    TicketNumber = _lottery.Tickets.Count + i + 1,
                    PurchaseDate = DateTime.UtcNow
                };
                Context.Tickets.Add(ticket);
            }

            // Update account balance
            Account.Beer -= totalCost;
            Context.Accounts.Update(Account);

            await Context.SaveChangesAsync();

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error buying tickets: {ex.Message}", Severity.Error);
        }
    }
} 