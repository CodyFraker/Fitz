@using Fitz.WebPortal.Data
@using Microsoft.EntityFrameworkCore
@using Fitz.Features.Accounts.Models
@using Fitz.Features.Bank.Models
@inject WebPortalContext Context
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Account Details</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudText Typo="Typo.h6">@Account.Username</MudText>
                <MudText>Beer Balance: @Account.Beer</MudText>
                <MudText>Status: @(!Account.Deactivated ? "Active" : "Inactive")</MudText>
                <MudText>Lottery Subscription: @(Account.subscribeToLottery ? $"Yes ({Account.SubscribeTickets} tickets)" : "No")</MudText>
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-4"/>
                <MudText Typo="Typo.h6" Class="mb-4">Recent Transactions</MudText>

                @if (_transactions == null || !_transactions.Any())
                {
                    <MudText>No recent transactions found.</MudText>
                }
                else
                {
                    <MudTable Items="_transactions" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Date</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Amount</MudTh>
                            <MudTh>Reason</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Date">@context.Timestamp.ToLocalTime().ToString("g")</MudTd>
                            <MudTd DataLabel="Type">@context.Type</MudTd>
                            <MudTd DataLabel="Amount">@context.Amount</MudTd>
                            <MudTd DataLabel="Reason">@context.Reason</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Fitz.Features.Accounts.Models.Account Account { get; set; } = null!;

    private List<Fitz.WebPortal.Data.Transaction> _transactions = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadTransactions();
    }

    private async Task LoadTransactions()
    {
        try
        {
            _transactions = await Context.Transactions
                .Where(t => t.SenderId == Account.Id || t.RecipientId == Account.Id)
                .OrderByDescending(t => t.Timestamp)
                .Take(10)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading transactions: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
} 