@using Fitz.WebPortal.Data
@using Microsoft.EntityFrameworkCore
@using Fitz.Features.Accounts.Models
@using Fitz.Features.Lottery.Models
@inject BotContext BotContext
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Create New Lottery</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="@_isValid">
            <MudGrid>
                <MudItem xs="12">
                    <MudNumericField T="int" @bind-Value="_lottery.Pool" Label="Prize Pool (beer)" Required="true" Min="1" />
                </MudItem>
                <MudItem xs="12">
                    <MudDatePicker Date="_lottery.StartDate" DateChanged="date => _lottery.StartDate = date ?? DateTime.Today" Label="Start Date" Required="true" DateFormat="yyyy-MM-dd" />
                </MudItem>
                <MudItem xs="12">
                    <MudDatePicker Date="_lottery.EndDate" DateChanged="date => _lottery.EndDate = date ?? DateTime.Today.AddDays(7)" Label="End Date" Required="true" DateFormat="yyyy-MM-dd" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@(!_isValid)">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    
    private MudForm _form = null!;
    private bool _isValid;
    private Fitz.WebPortal.Data.Lottery _lottery = new()
    {
        StartDate = DateTime.Today,
        EndDate = DateTime.Today.AddDays(7),
        Pool = 10,
        CurrentLottery = true
    };
    
    private void Cancel()
    {
        MudDialog.Cancel();
    }
    
    private async Task Submit()
    {
        try
        {
            await _form.Validate();
            if (!_isValid)
            {
                return;
            }

            if (_lottery.EndDate <= _lottery.StartDate)
            {
                Snackbar.Add("End date must be after start date", Severity.Error);
                return;
            }

            if (_lottery.StartDate < DateTime.Today)
            {
                Snackbar.Add("Start date cannot be in the past", Severity.Error);
                return;
            }

            // Set all other lotteries to not current
            var existingLotteries = await BotContext.Lotteries.Where(l => l.CurrentLottery).ToListAsync();
            foreach (var lottery in existingLotteries)
            {
                lottery.CurrentLottery = false;
            }

            BotContext.Lotteries.Add(_lottery);
            await BotContext.SaveChangesAsync();

            MudDialog.Close(DialogResult.Ok(_lottery));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error creating lottery: {ex.Message}", Severity.Error);
        }
    }
} 