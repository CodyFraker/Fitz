@using Fitz.WebPortal.Data
@using Microsoft.EntityFrameworkCore
@using Fitz.Features.Accounts.Models
@using Fitz.Features.Lottery.Models
@inject WebPortalContext Context
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Draw Lottery Winner</MudText>
    </TitleContent>
    <DialogContent>
        @if (_lottery == null)
        {
            <MudAlert Severity="Severity.Error">No lottery data available</MudAlert>
        }
        else if (_lottery.Tickets == null || !_lottery.Tickets.Any())
        {
            <MudAlert Severity="Severity.Warning">This lottery has no tickets</MudAlert>
        }
        else
        {
            <MudGrid>
                <MudItem xs="12">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6">Lottery #@_lottery.Id</MudText>
                        <MudText>Prize Pool: @_lottery.Pool beer</MudText>
                        <MudText>Total Tickets: @_lottery.Tickets.Count</MudText>
                        <MudText>End Date: @_lottery.EndDate.ToString("g")</MudText>
                    </MudPaper>
                </MudItem>
                
                @if (_winnerSelected)
                {
                    <MudItem xs="12" Class="mt-4">
                        <MudPaper Class="pa-4 d-flex flex-column align-center">
                            <MudText Typo="Typo.h5" Class="mb-2">Winner</MudText>
                            <MudAvatar Color="Color.Success" Size="Size.Large" Class="mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" />
                            </MudAvatar>
                            <MudText Typo="Typo.h6">@_winnerUsername</MudText>
                            <MudText>Prize: @_lottery.Pool beer</MudText>
                            <MudText>Winning Ticket: #@_winningTicket?.TicketNumber</MudText>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="DrawWinner" 
                  Disabled="@(_lottery?.Tickets == null || !_lottery.Tickets.Any() || _winnerSelected)">
            Draw Winner
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int LotteryId { get; set; }
    
    private Fitz.Features.Lottery.Models.Lottery _lottery;
    private bool _winnerSelected;
    private string _winnerUsername = "";
    private Fitz.Features.Lottery.Models.Ticket _winningTicket;
    
    protected override async Task OnInitializedAsync()
    {
        await LoadLotteryData();
    }
    
    private async Task LoadLotteryData()
    {
        try
        {
            _lottery = await Context.Lotteries
                .Include(l => l.Tickets)
                .FirstOrDefaultAsync(l => l.Id == LotteryId);

            if (_lottery == null)
            {
                Snackbar.Add("Failed to load lottery data.", Severity.Error);
                return;
            }

            if (_lottery.WinningTicketId.HasValue)
            {
                _winningTicket = _lottery.Tickets.FirstOrDefault(t => t.Id == _lottery.WinningTicketId);
                if (_winningTicket != null)
                {
                    var winner = await Context.Accounts.FirstOrDefaultAsync(a => a.Id == _winningTicket.UserId);
                    _winnerUsername = winner?.Username ?? $"User {_winningTicket.UserId}";
                    _winnerSelected = true;
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading lottery data: {ex.Message}", Severity.Error);
        }
    }
    
    private void Cancel()
    {
        MudDialog.Cancel();
    }
    
    private async Task DrawWinner()
    {
        try
        {
            if (_lottery?.Tickets == null || !_lottery.Tickets.Any())
            {
                Snackbar.Add("No tickets available to draw from.", Severity.Warning);
                return;
            }

            // Randomly select a winning ticket
            var random = new Random();
            var tickets = _lottery.Tickets.ToList();
            _winningTicket = tickets[random.Next(tickets.Count)];

            // Update the lottery with the winning ticket
            _lottery.WinningTicketId = _winningTicket.Id;
            _lottery.CurrentLottery = false;
            _winningTicket.IsWinner = true;

            // Get the winner's username
            var winner = await Context.Accounts.FirstOrDefaultAsync(a => a.Id == _winningTicket.UserId);
            _winnerUsername = winner?.Username ?? $"User {_winningTicket.UserId}";

            // Save changes
            await Context.SaveChangesAsync();

            _winnerSelected = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error drawing winner: {ex.Message}", Severity.Error);
        }
    }
} 