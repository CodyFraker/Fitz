@page "/privacy"

<PageTitle>Privacy Policy - Fitz Bot</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    <MudText Typo="Typo.h3" Class="mb-4">Privacy Policy</MudText>
    
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudText Typo="Typo.h5" Class="mb-2">Information We Collect</MudText>
        <MudText Typo="Typo.body1">
            When you use Fitz Bot, we collect certain information from your Discord account, including your username, 
            Discord ID, and server membership information. This information is used to provide the bot's functionality 
            and to maintain your account within our system.
        </MudText>
    </MudPaper>
    
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudText Typo="Typo.h5" Class="mb-2">How We Use Your Information</MudText>
        <MudText Typo="Typo.body1">
            We use the information we collect to:
        </MudText>
        <MudList>
            <MudListItem Icon="@Icons.Material.Filled.Check">Provide and maintain the Fitz Bot service</MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Check">Track virtual currency and transactions within the bot</MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Check">Manage lottery entries and other bot features</MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Check">Improve and develop new features</MudListItem>
        </MudList>
    </MudPaper>
    
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudText Typo="Typo.h5" Class="mb-2">Data Retention</MudText>
        <MudText Typo="Typo.body1">
            We retain your information for as long as your account is active or as needed to provide you services. 
            If you wish to delete your data, please contact the bot administrators.
        </MudText>
    </MudPaper>
    
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudText Typo="Typo.h5" Class="mb-2">Contact Us</MudText>
        <MudText Typo="Typo.body1">
            If you have any questions about this Privacy Policy, please contact us through the Discord server.
        </MudText>
    </MudPaper>
</MudContainer> 