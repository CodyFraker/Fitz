@page "/lottery"
@using Fitz.WebPortal.Data
@using Microsoft.EntityFrameworkCore
@using Fitz.Features.Accounts.Models
@using Fitz.Features.Lottery.Models
@inject BotContext BotContext
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize]

<PageTitle>Lottery - Fitz</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudGrid>
        <MudItem xs="12">
            <MudPaper Class="pa-4">
                <MudGrid>
                    <MudItem xs="12" md="8">
                        <MudText Typo="Typo.h4">Lottery</MudText>
                    </MudItem>
                    <MudItem xs="12" md="4" Class="d-flex justify-end align-center">
                        <MudButton Color="Color.Primary" OnClick="OpenCreateDialog">Create New Lottery</MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>

        @if (_currentLottery != null)
        {
            <MudItem xs="12" Class="mt-4">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h5" Class="mb-4">Current Lottery</MudText>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudText>Prize Pool: @_currentLottery.Pool beer</MudText>
                            <MudText>Total Tickets: @(_currentLottery.Tickets?.Count ?? 0)</MudText>
                            <MudText>Start Date: @_currentLottery.StartDate.ToString("g")</MudText>
                            <MudText>End Date: @_currentLottery.EndDate.ToString("g")</MudText>
                            <MudText>Status: @(_currentLottery.CurrentLottery ? "Active" : "Ended")</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6" Class="d-flex flex-column justify-end align-end">
                            <MudButton Color="Color.Primary" OnClick="() => OpenBuyTicketsDialog(_currentLottery)"
                                     Disabled="@(!_currentLottery.CurrentLottery || DateTime.UtcNow > _currentLottery.EndDate)">
                                Buy Tickets
                            </MudButton>
                            <MudButton Color="Color.Secondary" OnClick="() => NavigateToDetails(_currentLottery.Id)" Class="mt-2">
                                View Details
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
        }

        <MudItem xs="12" Class="mt-4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h5" Class="mb-4">Past Lotteries</MudText>
                <MudTable Items="@_pastLotteries" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh>ID</MudTh>
                        <MudTh>Start Date</MudTh>
                        <MudTh>End Date</MudTh>
                        <MudTh>Prize Pool</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">#@context.Id</MudTd>
                        <MudTd DataLabel="Start Date">@context.StartDate.ToString("g")</MudTd>
                        <MudTd DataLabel="End Date">@context.EndDate.ToString("g")</MudTd>
                        <MudTd DataLabel="Prize Pool">@context.Pool beer</MudTd>
                        <MudTd DataLabel="Actions">
                            <MudButton Color="Color.Primary" Size="Size.Small" 
                                     OnClick="() => NavigateToDetails(context.Id)">
                                View Details
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private Fitz.WebPortal.Data.Lottery _currentLottery;
    private List<Fitz.WebPortal.Data.Lottery> _pastLotteries = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadLotteryData();
    }

    private async Task LoadLotteryData()
    {
        try
        {
            var currentLottery = await BotContext.Lotteries
                .Include(l => l.Tickets)
                .FirstOrDefaultAsync(l => l.CurrentLottery);

            _currentLottery = currentLottery;

            var pastLotteries = await BotContext.Lotteries
                .Where(l => !l.CurrentLottery)
                .OrderByDescending(l => l.EndDate)
                .ToListAsync();

            _pastLotteries = pastLotteries;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading lottery data: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<CreateLotteryDialog>("Create New Lottery");
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadLotteryData();
        }
    }

    private async Task OpenBuyTicketsDialog(Fitz.WebPortal.Data.Lottery lottery)
    {
        // Get the user's account
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var discordId = ulong.Parse(user.FindFirst(c => c.Type == "DiscordId")?.Value ?? "0");

        if (discordId == 0)
        {
            Snackbar.Add("Please log in to buy tickets.", Severity.Warning);
            return;
        }

        var account = await BotContext.Accounts.FirstOrDefaultAsync(a => a.Id == discordId);
        if (account == null)
        {
            Snackbar.Add("Account not found.", Severity.Error);
            return;
        }

        var parameters = new DialogParameters
        {
            { "LotteryId", lottery.Id },
            { "Account", account }
        };

        var dialog = await DialogService.ShowAsync<LotteryDialog>("Buy Lottery Tickets", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadLotteryData();
        }
    }

    private void NavigateToDetails(int lotteryId)
    {
        NavigationManager.NavigateTo($"/lottery/{lotteryId}");
    }
} 