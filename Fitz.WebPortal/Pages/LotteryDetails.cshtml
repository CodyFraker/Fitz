@page "{id:int}"
@model Fitz.WebPortal.Pages.LotteryDetailsModel
@{
    ViewData["Title"] = "Lottery Details";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Lottery #@Model.Lottery.Id Details</h1>
        <a asp-page="./Lottery" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-2"></i>Back to Lottery Management
        </a>
    </div>

    @if (Model.Lottery == null)
    {
        <div class="alert alert-danger">
            <p>Lottery not found.</p>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-6">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Lottery Information</h5>
                    </div>
                    <div class="card-body">
                        <p><strong>Start Date:</strong> @Model.Lottery.StartDate.ToString("MM/dd/yyyy HH:mm")</p>
                        <p><strong>End Date:</strong> @Model.Lottery.EndDate.ToString("MM/dd/yyyy HH:mm")</p>
                        <p><strong>Duration:</strong> @((Model.Lottery.EndDate - Model.Lottery.StartDate).TotalDays.ToString("F1")) days</p>
                        <p><strong>Status:</strong> 
                            @if (Model.Lottery.EndDate > DateTime.UtcNow)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Ended</span>
                            }
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Prize Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="text-center mb-3">
                            <h2 class="display-4">@Model.Lottery.Pool</h2>
                            <p class="text-muted">Total Prize Pool</p>
                        </div>
                        
                        <p><strong>Total Tickets:</strong> @Model.TotalTickets</p>
                        
                        @if (Model.Lottery.WinningTicketId.HasValue)
                        {
                            <div class="alert alert-success">
                                <h5>Winner</h5>
                                <p><strong>Username:</strong> @Model.WinnerUsername</p>
                                <p><strong>Ticket ID:</strong> @Model.Lottery.WinningTicketId</p>
                                <p><strong>Prize Amount:</strong> @Model.Lottery.Pool</p>
                            </div>
                        }
                        else if (Model.Lottery.EndDate <= DateTime.UtcNow)
                        {
                            <div class="alert alert-warning">
                                <p>This lottery has ended but no winner was selected.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Ticket Entries</h5>
            </div>
            <div class="card-body">
                @if (Model.Tickets.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Ticket ID</th>
                                    <th>User</th>
                                    <th>Purchase Date</th>
                                    <th>Ticket Number</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ticket in Model.Tickets)
                                {
                                    <tr class="@(ticket.Id == Model.Lottery.WinningTicketId ? "table-success" : "")">
                                        <td>@ticket.Id</td>
                                        <td>@Model.UserNames.GetValueOrDefault(ticket.UserId, "Unknown")</td>
                                        <td>@ticket.PurchaseDate.ToString("MM/dd/yyyy HH:mm")</td>
                                        <td>@ticket.TicketNumber</td>
                                        <td>
                                            @if (ticket.Id == Model.Lottery.WinningTicketId)
                                            {
                                                <span class="badge bg-success">Winner</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Regular</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">No tickets were purchased for this lottery.</div>
                }
            </div>
        </div>
    }
</div> 