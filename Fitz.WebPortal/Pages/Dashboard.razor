@page "/dashboard"
@using Fitz.WebPortal.Data
@using Fitz.Shared.Models
@using Microsoft.EntityFrameworkCore
@inject BotContext _context
@inject ISnackbar Snackbar
@attribute [Authorize]

<PageTitle>Dashboard - Fitz Bot</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    <MudText Typo="Typo.h3" Class="mb-4">Dashboard</MudText>
    
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4" Variant="Variant.Filled">
            <MudText>@_errorMessage</MudText>
        </MudAlert>
    }
    
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 100%;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <div>
                        <MudText Typo="Typo.subtitle1">Total Accounts</MudText>
                        <MudText Typo="Typo.h3">@_totalAccounts</MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" Size="Size.Large" />
                </MudStack>
                <MudDivider Class="my-2" />
                <MudButton Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward" Href="/accounts">View Details</MudButton>
            </MudPaper>
        </MudItem>
        
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 100%;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <div>
                        <MudText Typo="Typo.subtitle1">Current Lottery Pool</MudText>
                        <MudText Typo="Typo.h3">@_currentLotteryPool</MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.Casino" Color="Color.Secondary" Size="Size.Large" />
                </MudStack>
                <MudDivider Class="my-2" />
                <MudButton Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward" Href="/lottery">View Details</MudButton>
            </MudPaper>
        </MudItem>
        
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 100%;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <div>
                        <MudText Typo="Typo.subtitle1">Total Transactions</MudText>
                        <MudText Typo="Typo.h3">@_totalTransactions</MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.Payments" Color="Color.Info" Size="Size.Large" />
                </MudStack>
                <MudDivider Class="my-2" />
                <MudButton Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward" Href="/transactions">View Details</MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
    
    <MudGrid Class="mt-4">
        <MudItem xs="12" md="6">
            <MudPaper Elevation="2" Class="pa-4">
                <MudText Typo="Typo.h5" Class="mb-4">Recent Transactions</MudText>
                @if (_recentTransactions.Any())
                {
                    <MudTable Items="_recentTransactions" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@_loading" LoadingProgressColor="Color.Info">
                        <HeaderContent>
                            <MudTh>Date</MudTh>
                            <MudTh>From</MudTh>
                            <MudTh>To</MudTh>
                            <MudTh>Amount</MudTh>
                            <MudTh>Reason</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Date">@context.Timestamp.ToString("MM/dd/yyyy")</MudTd>
                            <MudTd DataLabel="From">@context.SenderName</MudTd>
                            <MudTd DataLabel="To">@context.RecipientName</MudTd>
                            <MudTd DataLabel="Amount">@context.Amount</MudTd>
                            <MudTd DataLabel="Reason">@context.Reason</MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText>No recent transactions found.</MudText>
                        </NoRecordsContent>
                    </MudTable>
                }
                else
                {
                    <MudText Typo="Typo.body1" Color="Color.Secondary">No recent transactions found.</MudText>
                }
            </MudPaper>
        </MudItem>
        
        <MudItem xs="12" md="6">
            <MudPaper Elevation="2" Class="pa-4">
                <MudText Typo="Typo.h5" Class="mb-4">Top Beer Holders</MudText>
                @if (_topAccounts.Any())
                {
                    <MudTable Items="_topAccounts" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@_loading" LoadingProgressColor="Color.Info">
                        <HeaderContent>
                            <MudTh>#</MudTh>
                            <MudTh>Username</MudTh>
                            <MudTh>Beer</MudTh>
                            <MudTh>Lifetime Beer</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="account">
                            <MudTd DataLabel="#">@(_topAccounts.IndexOf(account) + 1)</MudTd>
                            <MudTd DataLabel="Username">@account.Username</MudTd>
                            <MudTd DataLabel="Beer">@account.Beer</MudTd>
                            <MudTd DataLabel="Lifetime Beer">@account.LifetimeBeer</MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText>No accounts found.</MudText>
                        </NoRecordsContent>
                    </MudTable>
                }
                else
                {
                    <MudText Typo="Typo.body1" Color="Color.Secondary">No accounts found.</MudText>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private int _totalAccounts;
    private int _currentLotteryPool;
    private int _totalTransactions;
    private List<TransactionViewModel> _recentTransactions = new();
    private List<Fitz.WebPortal.Data.Account> _topAccounts = new();
    private string _errorMessage = string.Empty;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardDataAsync();
    }

    private async Task LoadDashboardDataAsync()
    {
        _loading = true;
        
        try
        {
            // Get total accounts
            _totalAccounts = await _context.Accounts.CountAsync(a => !a.Deactivated);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error getting accounts: {ex.Message}");
            _totalAccounts = 0;
        }

        // Get current lottery pool
        try
        {
            var currentLottery = await _context.Lotteries.FirstOrDefaultAsync(l => l.IsActive);
            _currentLotteryPool = currentLottery?.PrizePool ?? 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error retrieving lottery information: {ex.Message}");
            _currentLotteryPool = 0;
        }

        try
        {
            // Get total transactions
            _totalTransactions = await _context.Transactions.CountAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error getting transaction count: {ex.Message}");
            _totalTransactions = 0;
            _errorMessage = "Some database tables may not be fully set up yet. Please run the Discord bot first to ensure all tables are created.";
            Snackbar.Add(_errorMessage, Severity.Warning);
        }

        try
        {
            // Get recent transactions
            var recentTransactions = await _context.Transactions
                .OrderByDescending(t => t.Timestamp)
                .Take(10)
                .ToListAsync();

            // Get user names for transactions
            var userIds = recentTransactions
                .SelectMany(t => new[] { t.SenderId, t.RecipientId })
                .Distinct()
                .ToList();

            var accounts = await _context.Accounts
                .Where(a => userIds.Contains(a.Id))
                .ToDictionaryAsync(a => a.Id, a => a.Username);

            // Map transactions to view model
            _recentTransactions.Clear();
            foreach (var transaction in recentTransactions)
            {
                var senderName = transaction.SenderId == 0 
                    ? "System" 
                    : accounts.TryGetValue(transaction.SenderId, out var sender) ? sender : "Unknown";
                
                var recipientName = accounts.TryGetValue(transaction.RecipientId, out var recipient) 
                    ? recipient 
                    : "Unknown";

                _recentTransactions.Add(new TransactionViewModel
                {
                    Id = transaction.Id,
                    SenderId = transaction.SenderId,
                    RecipientId = transaction.RecipientId,
                    SenderName = senderName,
                    RecipientName = recipientName,
                    Amount = transaction.Amount,
                    Timestamp = transaction.Timestamp,
                    Reason = transaction.Reason
                });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error getting recent transactions: {ex.Message}");
            // Keep the list empty
            if (string.IsNullOrEmpty(_errorMessage) && ex.Message.Contains("doesn't exist"))
            {
                _errorMessage = "Some database tables may not be fully set up yet. Please run the Discord bot first to ensure all tables are created.";
                Snackbar.Add(_errorMessage, Severity.Warning);
            }
        }

        try
        {
            // Get top accounts by beer
            var sharedTopAccounts = await _context.Accounts
                .Where(a => !a.Deactivated)
                .OrderByDescending(a => a.Beer)
                .Take(5)
                .ToListAsync();
            
            _topAccounts = sharedTopAccounts.ToWebPortalAccounts().ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error getting top accounts: {ex.Message}");
            // Keep the list empty
        }
        
        _loading = false;
    }

    public class TransactionViewModel
    {
        public int Id { get; set; }
        public ulong SenderId { get; set; }
        public ulong RecipientId { get; set; }
        public string SenderName { get; set; } = string.Empty;
        public string RecipientName { get; set; } = string.Empty;
        public int Amount { get; set; }
        public DateTime Timestamp { get; set; }
        public string Reason { get; set; } = string.Empty;
    }
} 