@page
@model Fitz.WebPortal.Pages.AccountsModel
@{
    ViewData["Title"] = "Accounts";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>User Accounts</h1>
        <div>
            <div class="input-group">
                <input type="text" id="searchInput" class="form-control" placeholder="Search by username..." 
                       onkeyup="filterAccounts()">
                <button class="btn btn-outline-secondary" type="button" onclick="filterAccounts()">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            @if (Model.Accounts.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="accountsTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Username</th>
                                <th>Beer</th>
                                <th>Lifetime Beer</th>
                                <th>Safe Balance</th>
                                <th>Lottery Subscription</th>
                                <th>Created Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var account in Model.Accounts)
                            {
                                <tr>
                                    <td>@account.Id</td>
                                    <td>@account.Username</td>
                                    <td>@account.Beer</td>
                                    <td>@account.LifetimeBeer</td>
                                    <td>@account.SafeBalance</td>
                                    <td>
                                        @if (account.SubscribeToLottery)
                                        {
                                            <span class="badge bg-success">Subscribed (@account.SubscribeTickets tickets)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Not Subscribed</span>
                                        }
                                    </td>
                                    <td>@account.CreatedDate.ToString("MM/dd/yyyy")</td>
                                    <td>
                                        @if (account.Deactivated)
                                        {
                                            <span class="badge bg-danger">Deactivated</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group">
                                            <a asp-page="./AccountDetails" asp-route-id="@account.Id" class="btn btn-sm btn-primary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-page="./EditAccount" asp-route-id="@account.Id" class="btn btn-sm btn-warning">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-success" 
                                                    onclick="showAddBeerModal('@account.Id', '@account.Username')">
                                                <i class="bi bi-plus-circle"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-page="./Accounts" asp-route-pageNumber="@i">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
            else
            {
                <div class="alert alert-info">No accounts found.</div>
            }
        </div>
    </div>
</div>

<!-- Add Beer Modal -->
<div class="modal fade" id="addBeerModal" tabindex="-1" aria-labelledby="addBeerModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="addBeerModalLabel">Add Beer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="userId" name="UserId" />
                    <div class="mb-3">
                        <label for="username" class="form-label">Username</label>
                        <input type="text" class="form-control" id="username" readonly />
                    </div>
                    <div class="mb-3">
                        <label for="amount" class="form-label">Amount</label>
                        <input type="number" class="form-control" id="amount" name="Amount" min="1" required />
                    </div>
                    <div class="mb-3">
                        <label for="reason" class="form-label">Reason</label>
                        <select class="form-select" id="reason" name="Reason" required>
                            <option value="AdminAddBalance">Admin Add Balance</option>
                            <option value="Bonus">Bonus</option>
                            <option value="HappyHour">Happy Hour</option>
                            <option value="PollApproved">Poll Approved</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" asp-page-handler="AddBeer">Add Beer</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showAddBeerModal(userId, username) {
            document.getElementById('userId').value = userId;
            document.getElementById('username').value = username;
            var modal = new bootstrap.Modal(document.getElementById('addBeerModal'));
            modal.show();
        }

        function filterAccounts() {
            var input, filter, table, tr, td, i, txtValue;
            input = document.getElementById("searchInput");
            filter = input.value.toUpperCase();
            table = document.getElementById("accountsTable");
            tr = table.getElementsByTagName("tr");

            for (i = 1; i < tr.length; i++) {
                td = tr[i].getElementsByTagName("td")[1]; // Username column
                if (td) {
                    txtValue = td.textContent || td.innerText;
                    if (txtValue.toUpperCase().indexOf(filter) > -1) {
                        tr[i].style.display = "";
                    } else {
                        tr[i].style.display = "none";
                    }
                }
            }
        }
    </script>
} 