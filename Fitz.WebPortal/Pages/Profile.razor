@page "/profile"
@using Microsoft.AspNetCore.Components.Authorization
@using Fitz.WebPortal.Data
@using Microsoft.EntityFrameworkCore
@using Fitz.Features.Accounts.Models
@using Fitz.Features.Bank.Models
@inject WebPortalContext Context
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@attribute [Authorize]

<PageTitle>Profile - Fitz</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h5" Class="mb-4">Account Information</MudText>
                @if (_account == null)
                {
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                }
                else
                {
                    <MudList>
                        <MudListItem Icon="@Icons.Material.Filled.Person">
                            <MudText>Username: @_account.Username</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.LocalAtm">
                            <MudText>Beer Balance: @_account.Beer</MudText>
                        </MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.CheckCircle">
                            <MudText>Status: @(!_account.Deactivated ? "Active" : "Inactive")</MudText>
                        </MudListItem>
                    </MudList>

                    <MudDivider Class="my-4" />

                    <MudText Typo="Typo.h6" Class="mb-2">Lottery Settings</MudText>
                    <MudList>
                        <MudListItem Icon="@Icons.Material.Filled.Casino">
                            <MudText>Subscription: @(_account.subscribeToLottery ? "Active" : "Inactive")</MudText>
                        </MudListItem>
                        @if (_account.subscribeToLottery)
                        {
                            <MudListItem Icon="@Icons.Material.Filled.ConfirmationNumber">
                                <MudText>Tickets per Draw: @_account.SubscribeTickets</MudText>
                            </MudListItem>
                        }
                    </MudList>

                    <MudButton Color="Color.Primary" OnClick="OpenEditDialog" Class="mt-4">
                        Edit Profile
                    </MudButton>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h5" Class="mb-4">Recent Transactions</MudText>
                @if (_transactions == null || !_transactions.Any())
                {
                    <MudText>No recent transactions found.</MudText>
                }
                else
                {
                    <MudTable Items="_transactions" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Date</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Amount</MudTh>
                            <MudTh>Reason</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Date">@context.Timestamp.ToLocalTime().ToString("g")</MudTd>
                            <MudTd DataLabel="Type">@context.Type</MudTd>
                            <MudTd DataLabel="Amount">@context.Amount</MudTd>
                            <MudTd DataLabel="Reason">@context.Reason</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private Fitz.Features.Accounts.Models.Account _account;
    private List<Fitz.WebPortal.Data.Transaction> _transactions = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountData();
    }

    private async Task LoadAccountData()
    {
        try
        {
            // Get the user ID from the auth state
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (!user.Identity.IsAuthenticated)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }

            var discordId = ulong.Parse(user.FindFirst(c => c.Type == "DiscordId")?.Value ?? "0");
            if (discordId == 0)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }

            var account = await Context.Accounts
                .FirstOrDefaultAsync(a => a.Id == discordId);

            _account = account?.ToWebPortalAccount();

            if (_account == null)
            {
                NavigationManager.NavigateTo("/login");
                return;
            }

            await LoadTransactions();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading account data: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadTransactions()
    {
        try
        {
            var transactions = await Context.Transactions
                .Where(t => t.SenderId == _account.Id || t.RecipientId == _account.Id)
                .OrderByDescending(t => t.Timestamp)
                .Take(10)
                .ToListAsync();

            _transactions = transactions;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading transactions: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenEditDialog()
    {
        var parameters = new DialogParameters
        {
            { "Account", _account }
        };

        var dialog = await DialogService.ShowAsync<EditAccountDialog>("Edit Profile", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadAccountData();
        }
    }
} 