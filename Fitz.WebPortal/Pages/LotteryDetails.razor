@page "/lottery/{Id:int}"
@using Fitz.WebPortal.Data
@using Microsoft.EntityFrameworkCore
@using Fitz.Features.Accounts.Models
@using Fitz.Features.Lottery.Models
@inject BotContext BotContext
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Lottery Details - Fitz</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    @if (_lottery == null)
    {
        <MudAlert Severity="Severity.Error">Lottery not found.</MudAlert>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12">
                <MudPaper Class="pa-4">
                    <MudGrid>
                        <MudItem xs="12" md="8">
                            <MudText Typo="Typo.h4">Lottery #@_lottery.Id</MudText>
                            <MudText Typo="Typo.subtitle1">Start Date: @_lottery.StartDate.ToString("g")</MudText>
                            <MudText Typo="Typo.subtitle1">End Date: @_lottery.EndDate.ToString("g")</MudText>
                            <MudText Typo="Typo.subtitle1">Duration: @(_lottery.EndDate - _lottery.StartDate).TotalDays days</MudText>
                            <MudText Typo="Typo.subtitle1">Status: @(_lottery.CurrentLottery ? "Active" : "Ended")</MudText>
                        </MudItem>
                        <MudItem xs="12" md="4" Class="d-flex flex-column justify-end align-end">
                            @if (_lottery.CurrentLottery)
                            {
                                <MudButton Color="Color.Primary" OnClick="OpenBuyTicketsDialog">Buy Tickets</MudButton>
                                @if (DateTime.UtcNow > _lottery.EndDate)
                                {
                                    <MudButton Color="Color.Secondary" OnClick="OpenDrawDialog" Class="mt-2">Draw Winner</MudButton>
                                }
                            }
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" Class="mt-4">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h5" Class="mb-4">Prize Pool</MudText>
                    <MudText Typo="Typo.h3">@_lottery.Pool beer</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" Class="mt-4">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h5" Class="mb-4">Tickets</MudText>
                    @if (_lottery.Tickets == null || !_lottery.Tickets.Any())
                    {
                        <MudAlert Severity="Severity.Info">No tickets have been purchased yet.</MudAlert>
                    }
                    else
                    {
                        <MudTable Items="@_lottery.Tickets" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                            <HeaderContent>
                                <MudTh>Ticket #</MudTh>
                                <MudTh>Owner</MudTh>
                                <MudTh>Purchase Date</MudTh>
                                <MudTh>Status</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Ticket #">@context.TicketNumber</MudTd>
                                <MudTd DataLabel="Owner">@GetUsername(context.UserId)</MudTd>
                                <MudTd DataLabel="Purchase Date">@context.PurchaseDate.ToString("g")</MudTd>
                                <MudTd DataLabel="Status">
                                    @if (context.IsWinner)
                                    {
                                        <MudChip Color="Color.Success" Size="Size.Small">Winner</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip Color="Color.Default" Size="Size.Small">Regular</MudChip>
                                    }
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    [Parameter] public int Id { get; set; }

    private Fitz.Features.Lottery.Models.Lottery _lottery;
    private Dictionary<ulong, string> _usernameCache = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadLotteryData();
    }

    private async Task LoadLotteryData()
    {
        try
        {
            var lottery = await BotContext.Lotteries
                .Include(l => l.Tickets)
                .FirstOrDefaultAsync(l => l.Id == Id);

            _lottery = lottery?.ToWebPortalLottery();

            if (_lottery == null)
            {
                Snackbar.Add("Lottery not found.", Severity.Error);
                return;
            }

            await CacheUsernames();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading lottery data: {ex.Message}", Severity.Error);
        }
    }

    private async Task CacheUsernames()
    {
        try
        {
            if (_lottery?.Tickets == null || !_lottery.Tickets.Any())
            {
                return;
            }

            var userIds = _lottery.Tickets.Select(t => t.UserId).Distinct().ToList();
            var accounts = await BotContext.Accounts
                .Where(a => userIds.Contains(a.Id))
                .ToDictionaryAsync(a => a.Id, a => a.Username);

            _usernameCache = accounts;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading usernames: {ex.Message}", Severity.Error);
        }
    }

    private string GetUsername(ulong userId)
    {
        return _usernameCache.TryGetValue(userId, out var username) ? username : $"User {userId}";
    }

    private async Task OpenBuyTicketsDialog()
    {
        // Get the user's account
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var discordId = ulong.Parse(user.FindFirst(c => c.Type == "DiscordId")?.Value ?? "0");

        if (discordId == 0)
        {
            Snackbar.Add("Please log in to buy tickets.", Severity.Warning);
            return;
        }

        var account = await BotContext.Accounts.FirstOrDefaultAsync(a => a.Id == discordId);
        if (account == null)
        {
            Snackbar.Add("Account not found.", Severity.Error);
            return;
        }

        var parameters = new DialogParameters
        {
            { "LotteryId", _lottery.Id },
            { "Account", account }
        };

        var dialog = await DialogService.ShowAsync<LotteryDialog>("Buy Tickets", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadLotteryData();
        }
    }

    private async Task OpenDrawDialog()
    {
        if (!_lottery.CurrentLottery || DateTime.UtcNow <= _lottery.EndDate)
        {
            Snackbar.Add("Cannot draw winner yet.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            { "LotteryId", _lottery.Id }
        };

        var dialog = await DialogService.ShowAsync<DrawLotteryDialog>("Draw Winner", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadLotteryData();
        }
    }
} 