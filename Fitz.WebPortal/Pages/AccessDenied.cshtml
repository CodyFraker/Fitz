@page
@model Fitz.WebPortal.Pages.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card mt-5">
                <div class="card-header bg-danger text-white">
                    <h2 class="text-center">Access Denied</h2>
                </div>
                <div class="card-body text-center">
                    <p class="lead">You do not have permission to access this resource.</p>
                    <a asp-page="/Index" class="btn btn-primary">Return to Home</a>
                </div>
            </div>
        </div>
    </div>
</div> 