@page "/accessdenied"

<PageTitle>Access Denied - Fitz Bot</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudPaper Elevation="3" Class="pa-8">
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-4">Access Denied</MudText>
        <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-6">
            You do not have permission to access this resource.
        </MudText>
        
        <div class="d-flex justify-center">
            <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">
                Return to Home
            </MudButton>
        </div>
    </MudPaper>
</MudContainer> 